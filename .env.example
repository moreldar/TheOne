# ---------------------------------------------------------------------------
# MemoryCanvas — environment configuration
# Copy to .env and fill in. Nothing here should ever be committed with real
# values.
# ---------------------------------------------------------------------------

# --- App -----------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Database (Postgres, e.g. Supabase or Neon) ---------------------------
# This matches docker-compose.yml's postgres service out of the box — run
# `docker compose up -d` and this URL works with no changes.
DATABASE_URL="postgresql://memorycanvas:memorycanvas@localhost:5432/memorycanvas"

# --- Auth.js (NextAuth) ----------------------------------------------------
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# Optional OAuth providers (add more as needed)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Redis / BullMQ (job queue for AI generation) -------------------------
REDIS_URL="redis://localhost:6379"

# --- Object storage (S3-compatible: Cloudflare R2 or AWS S3) --------------
# Default assumption is Cloudflare R2. To use AWS S3 instead, set
# STORAGE_ENDPOINT to your regional S3 endpoint (or omit for AWS default)
# and STORAGE_REGION accordingly.
# "local" is a third option for dev/testing only — no cloud credentials
# needed, writes land in public/uploads and public/generations instead of
# S3. See src/lib/storage/localProvider.ts. Never use it in production.
STORAGE_PROVIDER="r2" # "r2" | "s3" | "local"
STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
STORAGE_REGION="auto"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_BUCKET_UPLOADS="memorycanvas-uploads"
STORAGE_BUCKET_GENERATIONS="memorycanvas-generations"
# Public CDN base URL that fronts the buckets (e.g. R2 custom domain or
# CloudFront distribution). Used to build public preview URLs.
STORAGE_PUBLIC_CDN_URL="https://cdn.example.com"

# --- Stripe -----------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- AI Generation provider ------------------------------------------------
# "mock" (no real transformation, just watermarks whatever you upload) and
# "gemini" (real image-to-image editing) are both wired up — see
# src/lib/providers/generation. Set to "gemini" and add GEMINI_API_KEY
# below to get real stylized output.
GENERATION_PROVIDER="mock"
# TODO(real-integration): self-hosted Qwen-Image-Edit endpoint (primary,
# per the original spec — not implemented yet; Gemini below works today).
QWEN_IMAGE_EDIT_ENDPOINT=""
QWEN_IMAGE_EDIT_API_KEY=""
# Gemini ("Nano Banana") image editing. Get a free key at
# https://aistudio.google.com/apikey — required when GENERATION_PROVIDER="gemini".
GEMINI_API_KEY=""
GEMINI_IMAGE_MODEL="gemini-2.5-flash-image"

# --- Moderation provider ----------------------------------------------------
# "passthrough" is a stub that approves everything and logs a TODO.
MODERATION_PROVIDER="passthrough"
# TODO(real-integration): AWS Rekognition
AWS_REKOGNITION_REGION=""
AWS_REKOGNITION_ACCESS_KEY_ID=""
AWS_REKOGNITION_SECRET_ACCESS_KEY=""
# TODO(real-integration): Hive Moderation
HIVE_MODERATION_API_KEY=""

# --- Fulfillment provider ---------------------------------------------------
# "stub" logs the fulfillment request and marks it as accepted.
FULFILLMENT_PROVIDER="stub"
# TODO(real-integration): Printful
PRINTFUL_API_KEY=""
PRINTFUL_STORE_ID=""

# --- Notification provider --------------------------------------------------
# "console" logs emails instead of sending them.
NOTIFICATION_PROVIDER="console"
# TODO(real-integration): Resend
RESEND_API_KEY=""
RESEND_FROM_EMAIL="orders@example.com"
# TODO(real-integration): Postmark (alternative to Resend)
POSTMARK_SERVER_TOKEN=""

# --- Product / funnel config -------------------------------------------------
# Max free AI generations allowed per guest session/IP before requiring
# email capture. See src/lib/config.ts.
FREE_GENERATION_CAP="5"

# --- Admin ------------------------------------------------------------------
# Comma-separated list of emails allowed into /admin.
ADMIN_EMAILS="you@example.com"
